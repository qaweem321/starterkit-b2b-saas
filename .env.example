# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string from the Neon dashboard (Connect -> Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Random string used to sign session cookies (32+ characters)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# The URL your app runs at
BETTER_AUTH_URL="http://localhost:3000"

# Optional: Resend API key for sending real emails. Without it, emails are printed in the terminal.
RESEND_API_KEY=""
# Optional: sender address (must be a domain verified in Resend)
EMAIL_FROM="StarterKit <onboarding@resend.dev>"

# Billing provider: "polar" (Stripe support coming next)
BILLING_PROVIDER="polar"

# Polar (https://polar.sh) - use sandbox.polar.sh for testing
POLAR_SERVER="sandbox"
POLAR_ACCESS_TOKEN=""
POLAR_PRO_PRODUCT_ID=""
POLAR_WEBHOOK_SECRET=""
